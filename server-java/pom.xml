<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Spring Boot Parent POM
      Provides default versions for all Spring Boot dependencies, so you don't have
      to specify exact versions for each library. This keeps dependency management simple.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>com.hms</groupId>
    <artifactId>hms-server</artifactId>
    <version>1.0.0</version>
    <name>HMS Spring Boot Server</name>
    <description>Hospital Management System - Spring Boot Backend (Java replacement for Node.js/Express)</description>

    <properties>
        <!-- Tell Maven to compile for Java 21 -->
        <java.version>21</java.version>
    </properties>

    <dependencies>

        <!-- ============================================================
             CORE WEB: Provides REST API support via Spring MVC.
             Equivalent to Express in Node.js.
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- ============================================================
             MONGODB: Spring Data MongoDB — repository interfaces,
             MongoTemplate, document mapping. Equivalent to Mongoose.
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>

        <!-- ============================================================
             SECURITY: Spring Security for authentication and CORS.
             We use it with JWT instead of sessions.
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- ============================================================
             VALIDATION: @NotBlank, @Min, @Email etc. on request DTOs.
             Equivalent to manual validation in the Node.js routes.
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ============================================================
             JWT: JJWT 0.12 library for creating and verifying tokens.
             Equivalent to the 'jsonwebtoken' npm package.
             - jjwt-api     : the interfaces you call in your code
             - jjwt-impl    : the actual implementation (runtime only)
             - jjwt-jackson : JSON serialization support (runtime only)
             ============================================================ -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ============================================================
             TESTING: JUnit 5, MockMvc, AssertJ — Spring Boot test slice
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
              Spring Boot Maven Plugin.
              - 'mvn spring-boot:run'  → starts the app
              - 'mvn package'          → creates an executable JAR
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
